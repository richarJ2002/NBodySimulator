{
  "editor.rulers": [
    {
      "column": 80,
      "color": "#1ce863"
    }
  ],
  "cmake.sourceDirectory": "${workspaceFolder}/SourceCode",
  "cmake.buildDirectory": "${workspaceFolder}/BuildEnvironment",
  "[c]": {
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[cpp]": {
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[python]": {
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.defaultFormatter": "ms-python.autopep8"
  },
  "[cmake]": {
    "editor.quickSuggestions": {
      "strings": true
    }
  },
  "editor.tabSize": 2,
  "editor.autoClosingComments": "always",
  "editor.indentSize": "tabSize",
  "editor.insertSpaces": true,
  "VSCodeCounter.exclude": [
    "**/.gitignore",
    "**/.vscode/**",
    "**/node_modules/**",
    "**/*.ini",
    "**/.VSCodeCounter/**"
  ],
  "files.exclude": {
    "**/.git": false,
    "**/.vscode": false
  },
  "C_Cpp.doxygen.generatedStyle": "/*!",
  "C_Cpp.doxygen.sectionTags": [
    "attention",
    "tparam",
    "param",
    "result",
    "returns",
    "retval",
    "exception",
    "deprecated",
    "warning",
    "note",
  ],
  "C_Cpp.simplifyStructuredComments": false,
  "editor.formatOnSave": true,
  "clang-format.executable": "C:/Users/richar_j/Desktop/Projects/NBodySimulator/.Configuration/Clang/clang-format.exe",
  "cmake.configureOnOpen": true,
  "workbench.colorTheme": "GitHub Dark Default",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "cmake.showConfigureWithDebuggerNotification": false,
  "python.createEnvironment.trigger": "off",
  "autopep8.args": [
    "--ignore=E402,E121",
    "--indent-size=2",
    "--max-line-length=80"
  ],
  "editor.largeFileOptimizations": false,
  "editor.scrollBeyondLastLine": false,
  "python.analysis.extraPaths": [
    "C:/Users/richar_j/Desktop/Projects/PythonTools"
  ]
}